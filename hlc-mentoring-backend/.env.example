PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-at-least-32-random-characters
DEFAULT_USER_PASSWORD=replace-with-a-temporary-password-for-development-seed-only
DEFAULT_MENTOR_PASSWORD=
# Temporary migration only: enable with an approved legacy password and UTC expiry, then disable and unset both values.
LEGACY_PASSWORD_LOGIN_ENABLED=false
LEGACY_DEFAULT_PASSWORD=
LEGACY_PASSWORD_LOGIN_UNTIL=
BOOTSTRAP_ADMIN_KEY=replace-with-a-one-time-bootstrap-key
MOCK_DATE=
# Set to the exact number of trusted reverse-proxy hops in the deployment (for example, 1 behind one proxy).
TRUST_PROXY_HOPS=1
